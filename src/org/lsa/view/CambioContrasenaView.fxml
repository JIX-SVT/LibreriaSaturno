<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.lsa.controler.CambioContrasenaControler">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <Label text="Cambiar Contraseña">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        
        <VBox spacing="5.0">
            <children>
                <Label text="Contraseña Actual:" />
                <PasswordField fx:id="txtCurrentPassword" promptText="Ingrese su contraseña actual" />
            </children>
        </VBox>
        
        <VBox spacing="5.0">
            <children>
                <Label text="Nueva Contraseña:" />
                <PasswordField fx:id="txtNewPassword" promptText="Ingrese la nueva contraseña" />
            </children>
        </VBox>
        
        <VBox spacing="5.0">
            <children>
                <Label text="Confirmar Nueva Contraseña:" />
                <PasswordField fx:id="txtConfirmPassword" promptText="Repita la nueva contraseña" />
            </children>
        </VBox>
        
        <Button mnemonicParsing="false" onAction="#handleUpdatePassword" prefHeight="30.0" prefWidth="200.0" text="Actualizar Contraseña">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Button>
    </children>
</VBox>
