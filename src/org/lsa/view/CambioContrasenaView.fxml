<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="448.0" prefWidth="420.0" spacing="10.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.lsa.controler.CambioContrasenaControler">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label prefHeight="34.0" prefWidth="190.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Cambiar Contraseña" />

    <Label text="Contraseña Actual" />
    <PasswordField fx:id="txtCurrentPassword" />

    <Label text="Nueva Contraseña" />
    <PasswordField fx:id="txtNewPassword" />

    <Label text="Confirmar Nueva Contraseña" />
    <PasswordField fx:id="txtConfirmPassword" />

    <Button defaultButton="true" onAction="#handleUpdatePassword" text="Actualizar Contraseña" />
</VBox>
