<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<BorderPane prefHeight="560.0" prefWidth="1036.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.lsa.controller.NuevaVentaController">
<padding>
<Insets bottom="20" left="20" right="20" top="20" />
</padding>
 
    <left>
<VBox maxWidth="356.0" minWidth="300" prefHeight="520.0" prefWidth="351.0" spacing="10">
<padding>
<Insets right="20" />
</padding>
<Button fx:id="btnVolverMenu1" onAction="#handleVolverMenu" prefWidth="120" text="Volver al Menú" />
<Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Registrar Venta" />
         <Label prefHeight="17.0" prefWidth="63.0" text="Cliente:" />
<ComboBox fx:id="cmbRol" prefWidth="300.0" promptText="Cliente" />
         <Label prefHeight="17.0" prefWidth="63.0" text="Libro" />
<ComboBox fx:id="cmbEstado" prefWidth="300.0" promptText="Libro" />
<HBox spacing="10" />
         <GridPane prefHeight="67.0" prefWidth="288.0">
           <columnConstraints>
             <ColumnConstraints hgrow="SOMETIMES" maxWidth="78.0" minWidth="10.0" prefWidth="63.0" />
               <ColumnConstraints hgrow="SOMETIMES" maxWidth="105.0" minWidth="10.0" prefWidth="105.0" />
               <ColumnConstraints hgrow="SOMETIMES" maxWidth="87.0" minWidth="10.0" prefWidth="34.0" />
             <ColumnConstraints hgrow="SOMETIMES" maxWidth="163.0" minWidth="10.0" prefWidth="142.0" />
           </columnConstraints>
           <rowConstraints>
             <RowConstraints maxHeight="25.0" minHeight="8.0" prefHeight="14.0" vgrow="SOMETIMES" />
             <RowConstraints maxHeight="52.0" minHeight="10.0" prefHeight="46.0" vgrow="SOMETIMES" />
             <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
           </rowConstraints>
            <children>
               <Label prefHeight="17.0" prefWidth="63.0" text="Cantidad:" GridPane.rowIndex="1" />
               <Spinner GridPane.columnIndex="1" GridPane.rowIndex="1" />
               <Button mnemonicParsing="false" prefHeight="25.0" prefWidth="160.0" text="Agregar" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            </children>
         </GridPane>
         <Line endX="248.5" startX="-100.0" stroke="#979191a3" />
         <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Total: Q0.00" />
         <Button mnemonicParsing="false" onAction="#handleRegistrarventa" prefHeight="25.0" prefWidth="120.0" text="Registrar Venta" />
</VBox>
</left>
 
    <center>
<VBox spacing="10">
<Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Lista de ventas" />
<TableView fx:id="tblUsuarios" prefHeight="482.0" prefWidth="677.0">
<columns>
<TableColumn fx:id="colId" prefWidth="126.0" text="ISBN" />
<TableColumn fx:id="colUsuario" prefWidth="208.0" text="Titulo" />
<TableColumn fx:id="colNombre" minWidth="0.0" prefWidth="75.0" text="Precio" />
<TableColumn fx:id="colApellido" prefWidth="114.0" text="Cantidad" />
<TableColumn fx:id="colCorreo" prefWidth="121.0" text="Subtotal" />
</columns>
</TableView>
</VBox>
</center>
</BorderPane>
