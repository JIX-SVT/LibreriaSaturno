<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" stylesheets="@dashboardadminview.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.lsa.controller.DashboardAdminController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Dashboard Administrativo" />
        <Region HBox.hgrow="ALWAYS" />
      <Button mnemonicParsing="false" onAction="#handleVolverMenu" prefHeight="25.0" prefWidth="102.0" text="Volver a Menú" />
        <Button onAction="#handleCerrarSesion" text="Cerrar Sesión" />
    </HBox>

    <HBox spacing="20">
        <VBox alignment="CENTER" style="-fx-border-color: #cccccc; -fx-border-radius: 8; -fx-background-color: #f9f9f9; -fx-padding: 15;" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 13px; -fx-text-fill: #555555;" text="Ventas Totales" />
            <Label fx:id="lblVentasTotales" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;" text="Q0.00" />
        </VBox>

        <VBox alignment="CENTER" style="-fx-border-color: #cccccc; -fx-border-radius: 8; -fx-background-color: #f9f9f9; -fx-padding: 15;" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 13px; -fx-text-fill: #555555;" text="Total de Libros en Catálogo" />
            <Label fx:id="lblTotalLibros" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1565c0;" text="0" />
        </VBox>

        <VBox alignment="CENTER" style="-fx-border-color: #cccccc; -fx-border-radius: 8; -fx-background-color: #f9f9f9; -fx-padding: 15;" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 13px; -fx-text-fill: #555555;" text="Usuarios Activos" />
            <Label fx:id="lblUsuariosActivos" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #ef6c00;" text="0" />
        </VBox>
    </HBox>

    <Separator />

    <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Acceso a Módulos Globales" />

    <HBox spacing="15">
        <Button onAction="#handleGestionarUsuarios" prefHeight="45" prefWidth="180" style="-fx-background-color: #37474f; -fx-text-fill: white;" text="Gestionar Usuarios" />
        <Button onAction="#handleReportesVentas" prefHeight="45" prefWidth="180" style="-fx-background-color: #37474f; -fx-text-fill: white;" text="Reportes de Ventas" />
        <Button onAction="#handleReportesInventario" prefHeight="45" prefWidth="180" style="-fx-background-color: #37474f; -fx-text-fill: white;" text="Reporte de Inventario" />
    </HBox>
</VBox>
