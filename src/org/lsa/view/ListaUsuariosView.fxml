<?xml version="1.0" encoding="UTF-8"?>
 
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
 
<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.lsa.controller.ListaUsuariosController">
<padding>
<Insets bottom="20" left="20" right="20" top="20" />
</padding>
 
    <left>
<VBox maxWidth="300" minWidth="300" spacing="10">
<padding>
<Insets right="20" />
</padding>
<Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Registra tu Usuario" />
<TextField fx:id="txtID" promptText="ID" />
<TextField fx:id="txtUsuario" promptText="Usuario" />
<TextField fx:id="txtNombre" promptText="Nombre" />
<TextField fx:id="txtApellido" promptText="Apellido" />
<TextField fx:id="txtCorreo" promptText="Correo" />
<PasswordField fx:id="txtContraseña" promptText="Contraseña" />
<!-- ComboBox con fx:id asignados -->
<ComboBox fx:id="cmbRol" prefWidth="300.0" promptText="Rol" />
<ComboBox fx:id="cmbEstado" prefWidth="300.0" promptText="Estado" />
<HBox spacing="10">
<Button fx:id="btnGuardar" onAction="#handleGuardarUsuario" prefWidth="120" text="Guardar" />
<Button fx:id="btnEditar" onAction="#handleEditarUsuario" prefWidth="120" text="Editar" />
<Button fx:id="btnDesactivar" onAction="#handleDesactivarUsuario" prefWidth="120" text="Desactivar" />
<Button fx:id="btnLimpiar" onAction="#handleLimpiarUsuario" prefWidth="120" text="Limpiar" />
</HBox>
<Button fx:id="btnVolverMenu" onAction="#handleCambiarContraseña" prefWidth="120" text="Cambiar Contraseña" />
<Button fx:id="btnVolverMenu1" onAction="#handleVolverMenu" prefWidth="120" text="Volver al Menú" />
</VBox>
</left>
 
    <center>
<VBox spacing="10">
<Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Lista de Usuarios" />
<TableView fx:id="tblUsuarios">
<columns>
<TableColumn fx:id="colId" prefWidth="60" text="ID" />
<TableColumn fx:id="colUsuario" prefWidth="120" text="Usuario" />
<TableColumn fx:id="colNombre" prefWidth="120" text="Nombre" />
<TableColumn fx:id="colApellido" prefWidth="120" text="Apellido" />
<TableColumn fx:id="colCorreo" prefWidth="150" text="Correo" />
<TableColumn fx:id="colRol" prefWidth="100" text="Rol" />
<TableColumn fx:id="colEstado" prefWidth="80" text="Estado" />
</columns>
</TableView>
</VBox>
</center>
</BorderPane>