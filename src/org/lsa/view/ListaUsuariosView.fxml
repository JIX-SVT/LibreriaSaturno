<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.miguelio.controller.EditorialFXController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <left>
        <VBox maxWidth="300" minWidth="300" spacing="10">
            <padding>
                <Insets right="20" />
            </padding>
            <Label prefHeight="27.0" prefWidth="173.0" style="-fx-font-size: 18; -fx-font-weight: bold;" text="Usuarios" />
            <TextField fx:id="txtNombre" promptText="Usuario" />
            <TextField fx:id="txtNombre" promptText="Nombre" />
         <TextField fx:id="txtApellido" promptText="Apellido" />
         <TextField fx:id="txtCorreo" promptText="Correo" />
         <TextField fx:id="txtFC" promptText="Fecha de creación" />
            <HBox spacing="10">
                <Button onAction="#handleGuardar" prefWidth="120" text="Guardar" />
            <Button onAction="#handleEditar" prefWidth="120" text="Editar" />
            <Button onAction="#handleDesactivar" prefWidth="120.0" text="Desactivar" />
            </HBox>
             <Button onAction="#handleLimpiar" prefWidth="120" text="Limpiar" />
            <Label fx:id="lblMensaje" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Lista de Usuarios" />
            <TableView fx:id="tablaEditorial">
                <columns>
                    <TableColumn fx:id="colNIT" prefWidth="120" text="Usuario" />
                    
                    <TableColumn fx:id="colNombre" prefWidth="140" text="Nombre" />
                    
                    <TableColumn fx:id="colTelefono" prefWidth="140" text="Apellido" />

                    <TableColumn fx:id="colDireccion" prefWidth="200" text="Correo" />
               <TableColumn fx:id="colDireccion1" prefWidth="200" text="Fecha de creación" />
                    
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button onAction="#handleActualizarEditorial" text="Actualizar Tabla" />
                <Button onAction="#handleVolverEditorial" text="Volver al Menú" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
