<?xml version="1.0" encoding="UTF-8"?>
 
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
 
<VBox spacing="15" stylesheets="@dashboardcajeroview.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.lsa.controller.DashboardCajeroController">
<padding>
<Insets bottom="15" left="15" right="15" top="15" />
</padding>
 
    <HBox alignment="CENTER_LEFT" spacing="20">
<Label style="-fx-font-family: 'Century Gothic'; -fx-font-size: 20px; -fx-font-weight: bold;" text="Dashboard de Caja" textFill="#6383fa" />
<Region HBox.hgrow="ALWAYS" />
<Button mnemonicParsing="false" onAction="#handleVolverMenu" prefHeight="25.0" prefWidth="115.0" style="-fx-font-family: 'Century Gothic'; -fx-text-fill: white; -fx-background-color: #1800ad;" text="Volver a Menú" />
<Button onAction="#handleCerrarSesion" style="-fx-font-family: 'Century Gothic'; -fx-text-fill: white; -fx-background-color: #1800ad;" text="Cerrar Sesión" />
</HBox>
 
    <HBox spacing="15">
<VBox style="-fx-font-family: 'Century Gothic'; -fx-border-color: #a6a6a6; -fx-border-radius: 5; -fx-padding: 10; -fx-background-color: #ffffff;" HBox.hgrow="ALWAYS">
<Label style="-fx-font-family: 'Century Gothic'; -fx-font-size: 12px; -fx-text-fill: #a6a6a6;" text="Ventas del Día" />
<Label fx:id="lblVentasHoy" style="-fx-font-family: 'Century Gothic'; -fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1800ad;" text="Q0.00" />
</VBox>
<Button onAction="#handleNuevaVenta" prefHeight="50" style="-fx-font-family: 'Century Gothic'; -fx-background-color: #6383fa; -fx-text-fill: white; -fx-font-size: 14px;" text="+ Nueva Venta" />
</HBox>
 
    <Label style="-fx-font-family: 'Century Gothic'; -fx-font-weight: bold;" text="Buscador de Libros (Punto de Venta)" />
 
    <HBox spacing="10">
<TextField fx:id="txtBusqueda" promptText="Buscar por Título, Autor o ISBN..." style="-fx-font-family: 'Century Gothic'; -fx-prompt-text-fill: #a6a6a6;" HBox.hgrow="ALWAYS" />
<Button onAction="#handleBuscar" style="-fx-font-family: 'Century Gothic'; -fx-background-color: #a6a6a6; -fx-text-fill: white;" text="Buscar" />
</HBox>
 
    <TableView fx:id="tblResultados" style="-fx-font-family: 'Century Gothic';" VBox.vgrow="ALWAYS">
<columns>
<TableColumn fx:id="colIsbn" prefWidth="120" style="-fx-font-family: 'Century Gothic';" text="ISBN" />
<TableColumn fx:id="colTitulo" prefWidth="250" style="-fx-font-family: 'Century Gothic';" text="Título" />
<TableColumn fx:id="colAutor" prefWidth="180" style="-fx-font-family: 'Century Gothic';" text="Autor" />
<TableColumn fx:id="colPrecio" prefWidth="90" style="-fx-font-family: 'Century Gothic';" text="Precio" />
<TableColumn fx:id="colStock" prefWidth="90" style="-fx-font-family: 'Century Gothic';" text="Stock" />
</columns>
</TableView>
</VBox>