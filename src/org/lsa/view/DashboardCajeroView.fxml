<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.lsa.controller.DashboardCajeroController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Panel Caja " />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleVolverMenu" text="Volver al Menú" />
        <Button onAction="#handleCerrarSesion" text="Cerrar Sesión" />
    </HBox>
    <VBox spacing="10">
        <Label style="-fx-font-weight: bold;" text="Buscador de Libros" />
        <HBox spacing="10">
            <TextField fx:id="txtBusqueda" promptText="Buscar por Título, Autor o ISBN..." HBox.hgrow="ALWAYS" />
            <Button onAction="#handleAgregarAlCarrito" text="Agregar al Carrito" />
        </HBox>
        <TableView fx:id="tblLibros" prefHeight="180.0">
            <columns>
                <TableColumn fx:id="colIsbn" prefWidth="120.0" text="ISBN" />
                <TableColumn fx:id="colTitulo" prefWidth="110.0" text="Título" />
                <TableColumn fx:id="colPrecio" prefWidth="148.0" text="Precio" />
                <TableColumn fx:id="colStock" prefWidth="156.0" text="Stock" />
            </columns>
        </TableView>
    </VBox>
    <Separator />
    <VBox spacing="10" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Carrito de Compras" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleQuitarDelCarrito" text="Quitar Item" />
        </HBox>
        <TableView fx:id="tblCarrito" prefHeight="200.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCarritoIsbn" prefWidth="110.0" text="ISBN" />
                <TableColumn fx:id="colCarritoTitulo" prefWidth="180.0" text="Título" />
                <TableColumn fx:id="colCarritoPrecio" prefWidth="80.0" text="Precio" />
                <TableColumn fx:id="colCarritoStock" prefWidth="80.0" text="Stock" />
                <TableColumn fx:id="colCarritoSubtotal" prefWidth="100.0" text="Subtotal" />
            </columns>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="15">
            <Label fx:id="lblTotalPagar" text="Q 0.00" />
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Total a Pagar:" />
            <Button onAction="#handleResumenDia" text="Resumen del Dìa" />
         <Button onAction="#handleProcesarPago" text="Procesar Pago" />
        </HBox>
    </VBox>
</VBox>
