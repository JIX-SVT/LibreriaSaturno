<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15" style="-fx-background-color: WHITE;" stylesheets="@dashboardcajeroview.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.lsa.controller.DashboardCajeroController">
<padding>
<Insets bottom="15" left="15" right="15" top="15" />
</padding>
<HBox alignment="CENTER_LEFT" spacing="20">
<Label text="Panel  Caja">
         <font>
            <Font size="36.0" />
         </font></Label>
<Region HBox.hgrow="ALWAYS" />
<Button mnemonicParsing="false" onAction="#handleVolverMenu" prefHeight="25.0" prefWidth="115.0" text="Volver a Menú" />
<Button onAction="#handleCerrarSesion" text="Cerrar Sesión" />
</HBox>
<Label text="Buscador de Libros" />
<HBox spacing="15" />
<HBox spacing="10">
   <TextField fx:id="txtBusqueda" promptText="Buscar por Título, Autor o ISBN" HBox.hgrow="ALWAYS" />
   <Button onAction="#handleBuscar" text="Buscar" />
</HBox>
<TableView fx:id="tblResultados" prefWidth="732.0" VBox.vgrow="ALWAYS">
<columns>
<TableColumn fx:id="colIsbn" prefWidth="120" text="ISBN" />
<TableColumn fx:id="colTitulo" prefWidth="245.0" text="Título" />
<TableColumn fx:id="colAutor" prefWidth="185.0" text="Autor" />
<TableColumn fx:id="colPrecio" prefWidth="90" text="Precio" />
<TableColumn fx:id="colStock" prefWidth="90" text="Stock" />
</columns>
</TableView>
</VBox>
