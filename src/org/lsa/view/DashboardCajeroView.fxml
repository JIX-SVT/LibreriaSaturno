<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400" prefWidth="600" spacing="20" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.lsa.controller.DashboardCajeroController">
   <children>
      <Pane prefHeight="444.0" prefWidth="600.0">
         <children>
            <Label layoutX="155.0" layoutY="64.0" prefHeight="57.0" prefWidth="290.0" text="Bienvenido Cajero" textFill="#3679e3">
               <font>
                  <Font name="Corbel Light" size="27.0" />
               </font>
            </Label>
            <Button layoutX="238.0" layoutY="252.0" mnemonicParsing="false" onAction="#handleCerrarSesion" text="Cerrar Sesión">
               <font>
                  <Font name="Corbel Light" size="16.0" />
               </font>
            </Button>
            <Button layoutX="239.0" layoutY="208.0" mnemonicParsing="false" onAction="#handleIngresar" prefHeight="11.0" prefWidth="108.0" text="Ingresar">
               <font>
                  <Font name="Corbel Light" size="16.0" />
               </font>
            </Button>
         </children>
      </Pane>
   </children>
</VBox>