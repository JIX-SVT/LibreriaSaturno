<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="600.0" prefWidth="950.0" style="-fx-background-color: #f4f5f7;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.lsa.controller.ResumenDelDiaController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="65.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets left="20.0" right="20.0" />
         </padding>
         <children>
            <Circle fx:id="avatarCircle" radius="18.0" styleClass="avatar" />
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <VBox alignment="CENTER_LEFT">
                     <children>
                        <Label fx:id="lblBienvenida" text="Bienvenido" />
                        <Label fx:id="lblRol" text="Administrador" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </top>
   <left>
      <VBox prefWidth="220.0" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="20.0" />
         </padding>
         <children>
            <Label text="Navegación" />
            <Separator />
            <Button fx:id="btnResumenDia" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #e5e7eb;" text="📊  Resumen del Día" />
            <Button fx:id="btnVolver" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleVolver" text="⬅  Regresar" />
            <Region VBox.vgrow="ALWAYS" />
            <Separator />
         </children>
      </VBox>
   </left>
   <center>
      <VBox spacing="20.0" style="-fx-background-color: #f4f5f7;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="20.0" />
         </padding>
         <children>
            <VBox spacing="3.0">
               <children>
                  <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="Resumen del Día" />
                  <Label style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" text="Control de ventas y transacciones registradas el día de hoy" />
               </children>
            </VBox>
            <Separator style="-fx-background-color: #e5e7eb;" />
            
            <HBox spacing="20.0">
               <children>
                  <VBox alignment="CENTER" prefHeight="85.0" prefWidth="220.0" style="-fx-background-color: white; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                     <children>
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" text="Venta Total del Día" />
                        <Label fx:id="lblVentaTotalDia" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #059669;" text="Q 0.00" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" prefHeight="85.0" prefWidth="220.0" style="-fx-background-color: white; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                     <children>
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" text="Total de Facturas" />
                        <Label fx:id="lblTotalFacturas" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2563eb;" text="0" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <TableView fx:id="tablaResumen" prefHeight="320.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colNoFactura" prefWidth="110.0" text="No. Factura" />
                <TableColumn fx:id="colFecha" prefWidth="180.0" text="Fecha / Hora" />
                <TableColumn fx:id="colCliente" prefWidth="230.0" text="Cliente" />
                <TableColumn fx:id="colTotal" prefWidth="130.0" text="Total (Q)" />
              </columns>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>
