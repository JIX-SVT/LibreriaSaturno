<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="518.0" prefWidth="390.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.lsa.controller.LoginController">
<stylesheets>
<URL value="@/org/lsa/view/style/loginview.css" />
</stylesheets>
<children>
<VBox alignment="CENTER" layoutX="-2.0" layoutY="-7.0" prefHeight="525.0" prefWidth="401.0" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="-2.0" AnchorPane.rightAnchor="-9.0" AnchorPane.topAnchor="-7.0">
<children>
<!-- Título de Bienvenida -->
<Label prefHeight="33.0" prefWidth="179.0" style="-fx-font-size: Black;" text="Iniciar Sesión" textAlignment="CENTER" textFill="#0a0a0a">
<font>
<Font name="Century Gothic Bold" size="26.0" />
</font>
<VBox.margin>
<Insets bottom="20.0" />
</VBox.margin>
</Label>
 
                <!-- Campo de Usuario -->
<VBox maxWidth="250.0" spacing="5.0">
<children>
<Label text="Usuario:">
<font>
<Font name="Century Gothic" size="12.0" />
</font></Label>
<TextField fx:id="txtUsuario" promptText="Ingrese su usuario" />
</children>
</VBox>
 
                <!-- Campo de Contraseña -->
<VBox maxWidth="250.0" spacing="5.0">
<children>
<Label text="Contraseña:">
<font>
<Font name="Century Gothic" size="12.0" />
</font></Label>
<PasswordField fx:id="txtContrasena" promptText="Ingrese su contraseña" />
</children>
</VBox>
 
                <!-- Botón de Inicio de Sesión -->
<Button fx:id="btnIngresar" mnemonicParsing="false" onAction="#handleLogin" prefHeight="35.0" prefWidth="250.0" text="Ingresar" textFill="#030303">
<VBox.margin>
<Insets top="15.0" />
</VBox.margin>
<font>
<Font name="Century Gothic Bold" size="14.0" />
</font>
</Button>
</children>
</VBox>
</children>
</AnchorPane>
