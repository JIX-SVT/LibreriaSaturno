<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.lsa.controller.LoginController">
    <stylesheets>
        <URL value="@/org/lsa/view/style/loginview.css"/>
    </stylesheets>
    
    <children>
        <VBox alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <!-- Título de Bienvenida -->
                <Label text="Bienvenido a LibreriaSaturno" textAlignment="CENTER">
                    <font>
                        <Font name="System Bold" size="26.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </Label>

                <!-- Campo de Usuario -->
                <VBox maxWidth="250.0" spacing="5.0">
                    <children>
                        <Label text="Usuario:" />
                        <TextField fx:id="txtUsuario" promptText="Ingrese su usuario" />
                    </children>
                </VBox>

                <!-- Campo de Contraseña -->
                <VBox maxWidth="250.0" spacing="5.0">
                    <children>
                        <Label text="Contraseña:" />
                        <PasswordField fx:id="txtContrasena" promptText="Ingrese su contraseña" />
                    </children>
                </VBox>

                <!-- Botón de Inicio de Sesión -->
                <Button fx:id="btnIngresar" mnemonicParsing="false" onAction="#handleLogin" prefHeight="35.0" prefWidth="250.0" text="Ingresar">
                    <VBox.margin>
                        <Insets top="15.0" />
                    </VBox.margin>
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
            </children>
        </VBox>
    </children>
</AnchorPane>