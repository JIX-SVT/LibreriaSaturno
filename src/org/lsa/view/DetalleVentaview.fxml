<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="580.0" prefWidth="950.0" spacing="10.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.lsa.controller.DetalleVentaController">
<padding>
<Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
</padding>
<children>
<!-- Panel Izquierdo: Tabla de Historial -->
<VBox prefWidth="550.0" spacing="8.0" HBox.hgrow="ALWAYS">
<children>
<Label text="Historial de Ventas" textFill="#000000">
<font>
<Font name="Segoe UI" size="14.0" />
</font>
</Label>
      
             <Button fx:id="btnImprimirLateral" mnemonicParsing="false" onAction="#handleRegresarCajero" prefHeight="23.0" prefWidth="129.0" text="Regresar a Cajero">
      <font>
      <Font name="Segoe UI" size="12.0" />
      </font>
      </Button>
<TableView fx:id="tblVentas" prefHeight="530.0" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc;" VBox.vgrow="ALWAYS">
<columns>
<TableColumn fx:id="colIdVenta" prefWidth="110.0" text="No. Factura" />
<TableColumn fx:id="colCliente" prefWidth="200.0" text="Cliente" />
<TableColumn fx:id="colCajero" prefWidth="120.0" text="Empleado" />
<TableColumn fx:id="colTotal" prefWidth="90.0" text="Total" />
</columns>
<columnResizePolicy>
<TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
</columnResizePolicy>
</TableView>
</children>
</VBox>
 
      <!-- Panel Derecho: Detalle y vista previa del ticket -->
<VBox prefWidth="350.0" spacing="10.0" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-padding: 12;">
<children>
<Label text="Detalle de Transacción" textFill="#000000">
<font>
<Font name="Segoe UI" size="14.0" />
</font>
</Label>
<VBox spacing="4.0" style="-fx-padding: 4;">
<children>
<Label fx:id="lblFacturaNumero" text="Factura: ---" textFill="#333333" />
<Label fx:id="lblClienteDetalle" text="Cliente: ---" textFill="#333333" />
<Label fx:id="lblEmpleadoDetalle" text="Empleado: ---" textFill="#333333" />
<Label fx:id="lblTotalDetalle" text="Total: Q ---" textFill="#000000">
<font>
<Font name="Segoe UI Bold" size="12.0" />
</font>
</Label>
</children>
</VBox>
 
            <TextArea fx:id="txtAreaFacturaVisual" editable="false" prefHeight="270.0" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 11px; -fx-border-color: #cccccc;" VBox.vgrow="ALWAYS" />
            <Button fx:id="btnImprimirLateral1" mnemonicParsing="false" prefHeight="30.0" prefWidth="330.0" style="-fx-background-color: #ffffff; -fx-border-color: #666666; -fx-text-fill: #000000; -fx-cursor: hand;" text="Imprimir Comprobante">
               <font>
                  <Font name="Segoe UI" size="12.0" />
               </font>
            </Button>
</children>
</VBox>
</children>
</HBox>
